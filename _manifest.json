{
  "manifest_version": 2,
  "version": "1.4.5",
  "name": "日期上下文插件",
  "description": "提供 date/date_text/holiday 公开 API（仅今天）、query_date/query_holiday 工具（日期与特定节日查询），以及两个独立开关的模型请求前日期注入：回复模型（reply_injection）与 Planner（planner_injection），默认均关闭",
  "author": {
    "name": "xiexiaojia780",
    "url": "https://github.com/xiexiaojia780"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/xiexiaojia780/date_context_plugin"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "cnlunar",
      "version_spec": ">=0.2.4"
    },
    {
      "type": "python_package",
      "name": "chinese-calendar",
      "version_spec": ">=1.11.0"
    },
    {
      "type": "python_package",
      "name": "tzdata",
      "version_spec": ">=2024.1"
    }
  ],
  "capabilities": [],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "github.xiexiaojia780.date-context-plugin"
}
